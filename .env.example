# ============================================================================
# SENTINEL ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env file - it's in .gitignore
# This file is safe to commit with placeholder values
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Development: SQLite (local testing)
# DATABASE_URL=sqlite+aiosqlite:///./sentinel.db

# Production: PostgreSQL (recommended)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sentinel_db

# Database connection pool settings
DB_POOL_SIZE=20
DB_POOL_MAX_OVERFLOW=10
DB_ECHO=false

# ============================================================================
# API SERVER CONFIGURATION
# ============================================================================

API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://yourdomain.com

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================

# Generate secure secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-secrets-token
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# ============================================================================
# LLM CONFIGURATION
# ============================================================================

# OpenAI API (if using OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key-here-not-real
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Alternative: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# LLM_MODEL=claude-3-opus

# Alternative: Local Ollama
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# REDIS CONFIGURATION (Optional - for caching)
# ============================================================================

# Development (local)
# REDIS_URL=redis://localhost:6379/0

# Production (with password)
REDIS_URL=redis://:password@localhost:6379/0

# Redis settings
REDIS_CACHE_TTL=3600
REDIS_ENABLED=false

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/sentinel.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# ============================================================================
# AGENT CONFIGURATION
# ============================================================================

# Agent timeout settings (seconds)
SCANNER_TIMEOUT=300
THREAT_TIMEOUT=60
ATTACK_TIMEOUT=120
PATCH_TIMEOUT=150
REPORT_TIMEOUT=90

# Scanner settings
SCANNER_CONFIDENCE_THRESHOLD=0.6
SCANNER_SEVERITY_MINIMUM=low

# Report settings
REPORT_RISK_THRESHOLD=40
REPORT_MAX_FINDINGS=1000

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# Password hashing
PASSWORD_ALGORITHM=bcrypt
PASSWORD_HASH_ROUNDS=12

# HTTPS/SSL (production)
# HTTPS_ENABLED=true
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# Security headers
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
X_FRAME_OPTIONS=DENY

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Frontend URL for API calls
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Feature flags
NEXT_PUBLIC_ENABLE_DEMO=true
NEXT_PUBLIC_ENABLE_ADVANCED_FEATURES=false

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=UA-XXXXXXXXX-X

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================

# Slack notifications (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# SLACK_ENABLED=false

# Email notifications (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@sentinel.dev

# GitHub integration (optional)
# GITHUB_TOKEN=ghp_your-github-token-here
# GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Hot reload (development)
RELOAD=true

# Test mode
TEST_MODE=false

# Mock data for development
USE_MOCK_DATA=false
MOCK_DATA_SEED=42

# Database seeding
SEED_DATABASE=false

# ============================================================================
# PRODUCTION SETTINGS
# ============================================================================

# Environment
ENVIRONMENT=development
# ENVIRONMENT=production

# Workers (for production servers)
UVICORN_WORKERS=4

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Sentry error tracking (optional)
# SENTRY_DSN=https://your-key@sentry.io/project-id

# DataDog APM (optional)
# DATADOG_ENABLED=false
# DD_SERVICE=sentinel
# DD_VERSION=1.0.0

# Prometheus metrics
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# ============================================================================
# FILE STORAGE
# ============================================================================

# Local file storage
FILE_STORAGE_PATH=./storage

# S3 (optional - for production)
# AWS_S3_BUCKET=sentinel-uploads
# AWS_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# S3_ENABLED=false

# ============================================================================
# NOTES FOR SETUP
# ============================================================================

# 1. Generate JWT Secret:
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 2. Database Setup:
#    For PostgreSQL: createdb sentinel_db
#    For SQLite: No setup needed, created automatically
#
# 3. For Development:
#    - Use SQLite for testing
#    - Set DEBUG=true
#    - Use RELOAD=true
#    - Set NEXT_PUBLIC_ENABLE_DEMO=true
#
# 4. For Production:
#    - Use PostgreSQL
#    - Set DEBUG=false
#    - Generate strong JWT_SECRET
#    - Set proper CORS_ORIGINS
#    - Enable HTTPS
#    - Use strong passwords
#
# 5. LLM Integration:
#    - Get API key from OpenAI/Anthropic/etc
#    - Never commit API keys to git
#    - Use .env for sensitive values
#
# 6. Security:
#    - Change all default values
#    - Use unique JWT_SECRET
#    - Rotate API keys regularly
#    - Enable HTTPS in production
#    - Use strong database passwords
